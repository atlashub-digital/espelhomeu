{
  "name": "espelhomeu",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "validate:content": "node packages/project-content/scripts/sync-editorial.mjs --check && node packages/project-content/scripts/check-imports.mjs && pnpm --filter @espelhomeu/project-content exec vitest run src/validation.test.ts",
    "smoke:web": "node automation/smoke-web.mjs",
    "verify:browser": "node automation/verify-browser.mjs",
    "content:sync": "node packages/project-content/scripts/sync-editorial.mjs",
    "verify:access": "node automation/verify-access.mjs"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
