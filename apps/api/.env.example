# Copiar para .env (nunca commitar o .env)
NODE_ENV=development
PORT=4000
# Origem(ns) do frontend autorizadas por CORS, separadas por vírgula
WEB_ORIGINS=http://localhost:3000
# Postgres local (ver infra/vps/docker-compose.yml)
DATABASE_URL=postgres://espelhomeu:espelhomeu@localhost:5432/espelhomeu

# ARO notification receipt verification only; supplied securely by Helena
ARO_WEBHOOK_SECRET=

# Atlas Access V1 — OFF. No delivery transport is enabled by this implementation.
ACCESS_V1_ENABLED=false
ACCESS_V1_TEST_MODE=false
# Preview backend only (NODE_ENV must not be production). Supply secrets externally:
# ACCESS_V1_TEST_TOKEN=<at least 32 characters; test route only, never browser env>
# ACCESS_V1_ENCRYPTION_KEY=<64 hex characters; independent key, persist across restarts>
# SUPABASE_URL_MASTER=<approved Master URL, or local stub URL>
# SUPABASE_SERVICE_ROLE_KEY_MASTER=<backend only; never NEXT_PUBLIC_*>
