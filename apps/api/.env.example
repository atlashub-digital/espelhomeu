# Copiar para .env (nunca commitar o .env)
NODE_ENV=development
PORT=4000
# Origem(ns) do frontend autorizadas por CORS, separadas por vírgula
WEB_ORIGINS=http://localhost:3000
# Postgres local (ver infra/vps/docker-compose.yml)
DATABASE_URL=postgres://espelhomeu:espelhomeu@localhost:5432/espelhomeu

# ARO notification receipt verification only; supplied securely by Helena
ARO_WEBHOOK_SECRET=

# Atlas Access V1 — OFF. Transportes reais exigem gates explícitos.
ACCESS_V1_ENABLED=false
ACCESS_V1_TEST_MODE=false
# Preview backend only (NODE_ENV must not be production). Supply secrets externally:
# ACCESS_V1_TEST_TOKEN=<at least 32 characters; test route only, never browser env>
# ACCESS_V1_ENCRYPTION_KEY=<64 hex characters; independent key, persist across restarts>
# SUPABASE_URL_MASTER=<approved Master URL, or local stub URL>
# SUPABASE_SERVICE_ROLE_KEY_MASTER=<backend only; never NEXT_PUBLIC_*>

# Fase 3: defaults OFF. Nunca definir credenciais no repositório.
ACCESS_V1_EMAIL_TRANSPORT=off
ACCESS_V1_WA_TRANSPORT=off
ACCESS_V1_LIVE_ENABLED=false
# Não-production: lista explícita de destinatários controlados (separados por vírgula).
ACCESS_V1_EMAIL_ALLOWLIST=
ACCESS_V1_WA_ALLOWLIST=
ACCESS_V1_PUBLIC_ORIGIN=https://espelho.lia.doctor
# ACCESS_V1_SMTP_HOST=<hostname SMTP transacional Hostinger autorizado>
ACCESS_V1_SMTP_PORT=465
# HOSTINGER_EMAIL_TOKEN=<credencial SMTP de contact@atlashub.si>
# ATENDIMENTO_EVOLUTION_KEY=<key interna; instância fixa atlashub-wa>
# Handoff OFF enquanto ARO #24 não publicar o contrato acordado.
# ACCESS_V1_ARO_CLAIM_URL=<endpoint HTTPS de troca server-side>
# ACCESS_V1_ARO_SERVER_KEY=<SERVER KEY scoped ao projeto espelhomeu>
