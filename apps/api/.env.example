# Copiar para .env (nunca commitar o .env)
NODE_ENV=development
PORT=4000
# Origem(ns) do frontend autorizadas por CORS, separadas por vírgula
WEB_ORIGINS=http://localhost:3000
# Postgres local (ver infra/vps/docker-compose.yml)
DATABASE_URL=postgres://espelhomeu:espelhomeu@localhost:5432/espelhomeu

# Checkout próprio EspelhoMeu (Stripe Elements / Pix + cartão)
WEB_BASE_URL=http://localhost:3000
COMMERCE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=2025-06-30.basil
STRIPE_PAYMENT_METHODS=automatic
ACCESS_TOKEN_DAYS=180

# ARO pilot — Brazil PIX routing
API_PUBLIC_BASE_URL=http://localhost:4000
BR_PIX_PROVIDER=pixgo
PIXGO_API_KEY=
PIXGO_WEBHOOK_SECRET=
MISTICPAY_CLIENT_ID=
MISTICPAY_CLIENT_SECRET=

# Optional operational revenue notifications
REVENUE_TELEGRAM_BOT_TOKEN=
REVENUE_TELEGRAM_CHAT_ID=
REVENUE_DISCORD_WEBHOOK_URL=
