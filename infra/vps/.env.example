# Copiar para /opt/espelhomeu/.env na VPS (nunca commitar).
API_DOMAIN=api.espelhomeu.lia.doctor
WEB_ORIGINS=https://espelho.lia.doctor,https://espelhomeu.lia.doctor
WEB_BASE_URL=https://espelho.lia.doctor
API_PUBLIC_BASE_URL=https://api.espelhomeu.lia.doctor

POSTGRES_USER=espelhomeu
POSTGRES_PASSWORD=trocar-por-uma-password-forte
POSTGRES_DB=espelhomeu
API_IMAGE=ghcr.io/atlashub-digital/espelhomeu-api:latest

# Fast Launch Commerce
COMMERCE_ENABLED=false
BR_PIX_PROVIDER=pixgo
ACCESS_TOKEN_DAYS=180

# PixGo — provider inicial BR/PIX
PIXGO_API_KEY=
PIXGO_WEBHOOK_SECRET=

# MisticPay — fallback futuro
MISTICPAY_CLIENT_ID=
MISTICPAY_CLIENT_SECRET=

# Stripe — internacional, não é o default BR/PIX
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=2025-06-30.basil
STRIPE_PAYMENT_METHODS=automatic

# Revenue notifications — opcionais
REVENUE_TELEGRAM_BOT_TOKEN=
REVENUE_TELEGRAM_CHAT_ID=
REVENUE_DISCORD_WEBHOOK_URL=
